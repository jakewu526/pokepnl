# Copy this file to `.env` and fill in the values for your setup.
#
# This app has no separate API layer -- Server Components and Server Actions
# query Postgres directly through Prisma. That means "the server" is really
# just "wherever Postgres lives." There are two ways to run this app:
#
# ---------------------------------------------------------------------------
# OPTION A -- Server device (runs its own Postgres via `docker compose up -d`)
# ---------------------------------------------------------------------------
# DATABASE_URL points at your own local Postgres. No changes needed beyond
# filling in the password you set in docker-compose.yml.
#
#   DATABASE_URL="postgresql://pokemon:<password>@localhost:5432/pokemon_tcg?schema=public"
#
# ---------------------------------------------------------------------------
# OPTION B -- Client device (shares another device's database over Tailscale)
# ---------------------------------------------------------------------------
# Install Tailscale (https://tailscale.com) and join the same tailnet as the
# server device. Then point DATABASE_URL at the server's Tailscale hostname
# (find it in the Tailscale admin console, or `tailscale status` on the
# server -- with MagicDNS enabled it looks like `<device-name>.<tailnet>.ts.net`)
# instead of `localhost`:
#
#   DATABASE_URL="postgresql://pokemon:<password>@<server-tailscale-hostname>:5432/pokemon_tcg?schema=public"
#
# Client devices do NOT need Docker, and should NOT run `db:migrate` or any
# `ingest:*`/`snapshot:*` script -- those stay server-only. Just:
#   git clone, npm install, cp .env.example .env (fill in DATABASE_URL),
#   npx prisma generate, npm run dev.
DATABASE_URL="postgresql://pokemon:pokemon@localhost:5432/pokemon_tcg?schema=public"

# Server device only. Docker Compose auto-loads this file, so this is the
# single source of truth for the Postgres password -- docker-compose.yml
# references it as ${POSTGRES_PASSWORD} rather than hardcoding it. Must
# match the password portion of DATABASE_URL above.
POSTGRES_PASSWORD=""

# ---------------------------------------------------------------------------
# OPTION C -- UAT/staging instance (own app checkout, own DB, own port)
# ---------------------------------------------------------------------------
# The prod server device's docker-compose.yml also runs a second Postgres
# container (`postgres-uat`, host port 5433, database `pokemon_tcg_uat`) so
# UAT can be tested without touching prod data. This password is only read
# by the prod device's `docker compose up -d` (via ${POSTGRES_UAT_PASSWORD}
# in docker-compose.yml) -- leave blank on client devices and on the UAT
# checkout itself.
POSTGRES_UAT_PASSWORD=""
#
# The UAT app checkout's own .env should instead set:
#   DATABASE_URL="postgresql://pokemon:<uat-password>@localhost:5433/pokemon_tcg_uat?schema=public"
#   NEXT_PUBLIC_APP_ENV="uat"
# and run on its own port via NSSM (`next start -p 3001`) so it never
# collides with the prod instance on port 3000. NEXT_PUBLIC_APP_ENV drives
# the "UAT" badge next to the Binder logo on the home page (app/page.tsx) --
# leave it unset on prod.

# Secret key used to sign session cookies (generate via `openssl rand -base64 32`).
# Client devices can reuse the server's value or generate their own -- each
# Next.js instance issues/decrypts its own cookies independently, so either
# works, but reusing the server's keeps things predictable.
SESSION_SECRET=""

# API keys for data ingestion (server device only -- leave blank on clients).
# TCGplayer and PriceCharting are dormant/optional -- see scripts/snapshot-prices.ts,
# scripts/ingest-sealed-products.ts, scripts/link-tcgplayer-ids.ts, and
# scripts/backfill-pricecharting-history.ts. Card pricing works today without
# them via ingest-cards.ts (pokemontcg.io mirrors TCGplayer/Cardmarket prices).
TCGPLAYER_PUBLIC_KEY=""
TCGPLAYER_PRIVATE_KEY=""
PRICECHARTING_API_TOKEN=""

# eBay Buy Browse API -- free self-serve registration at
# https://developer.ebay.com/my/keys (no partner approval needed).
# Used as a sealed-product price proxy in scripts/ingest-sealed-products-ebay.ts.
# Server device only -- leave blank on clients.
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""

# "Connect eBay account" on the Settings page (app/settings/page.tsx) -- lets
# a signed-in user grant this app read access to their own eBay sold-order
# history via eBay's user-consent OAuth flow. Reuses EBAY_CLIENT_ID/SECRET
# above (same keyset, but you must add "User Tokens (OAuth)" with scopes
# sell.fulfillment.readonly and sell.finances.readonly in the eBay Developer
# Portal -- the Buy Browse API's client-credentials grant alone doesn't cover
# this).
#
# Unlike Google sign-in below, eBay's `redirect_uri` OAuth parameter is not a
# literal URL -- it's a "RuName" string the eBay Developer Portal issues once
# you register "Your auth accepted URL" (which itself must be a real URL,
# e.g. https://<hub-origin>/api/auth/ebay/callback). eBay looks up that
# registered URL from the RuName at login time, so -- like Google's HUB
# above -- only ONE origin can ever be the eBay callback target; there's no
# per-device dynamic redirect the way the app's own login flow has.
# Server device (the hub) only -- leave blank on client devices.
EBAY_RUNAME=""

# Google Sign-In uses a hub-and-spoke setup so only ONE device ever needs the
# Google client secret, even though every client device (Option B above) runs
# its own local `next dev` instance.
#
# ---------------------------------------------------------------------------
# HUB -- exactly one instance (normally the server device's prod app)
# ---------------------------------------------------------------------------
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (Application type: "Web application"). Because every login -- even ones
# started on a spoke device -- finishes on the hub's own origin (see
# app/api/auth/google/route.ts), only the HUB's origin needs to be added as
# an Authorized redirect URI -- but see the IMPORTANT note below before you
# pick which origin that is.
#
# Locally (same machine as the server), Google is happy with plain http:
#   http://localhost:3000/api/auth/google/callback
#
# IMPORTANT -- Google's OAuth policy only allows the http scheme when the
# host is literally "localhost" or a loopback IP. A real hostname (a
# Tailscale MagicDNS name, a LAN IP, anything) MUST use https, or Google
# rejects the redirect URI outright with "doesn't comply with Google's
# OAuth 2.0 policy" -- adding an http:// version of a real hostname will
# never work, no matter how many times you re-save it. For a hub reachable
# from other devices over Tailscale, terminate real TLS in front of it with
# `tailscale serve` (tailnet-only) or `tailscale funnel` (public internet)
# rather than hitting the app's plain-http port directly, then register
# *that* https URL, e.g.:
#   tailscale serve --bg --https=8443 http://127.0.0.1:3000
#   -> https://<server-tailscale-hostname>:8443/api/auth/google/callback
# See "Deployment: UAT and Production" in README.md for the actual
# Funnel/Serve endpoints currently configured for this app's prod and UAT.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# SPOKE -- every other device (client checkouts running their own `next dev`)
# ---------------------------------------------------------------------------
# Leave GOOGLE_CLIENT_ID/SECRET blank and set this instead, pointing at the
# hub's origin -- use whatever origin the hub actually registered as its
# redirect URI above (http://localhost:3000 if you're on the server machine
# itself, otherwise the https Tailscale Serve/Funnel URL, never a plain-http
# real hostname). "Continue with Google" on this device then redirects to
# the hub, which does the actual OAuth exchange and hands a short-lived
# token back to this device's /api/auth/handoff to finish the login
# locally. This device still needs the same SESSION_SECRET as the hub (see
# above) to verify that handoff.
#   AUTH_HUB_ORIGIN="https://<server-tailscale-hostname>:8443"
AUTH_HUB_ORIGIN=""
