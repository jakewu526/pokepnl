generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model CardSet {
  id             String   @id @default(cuid())
  name           String
  series         String?
  releaseDate    DateTime?
  totalCards     Int?
  code           String?
  logoUrl        String?
  symbolUrl      String?
  pokemonTcgIoId String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cards          Card[]
  sealedProducts SealedProduct[]
}

model Card {
  id                 String   @id @default(cuid())
  setId              String
  number             String
  name               String
  rarity             String?
  supertype          String?
  subtypes           String[]
  imageUrl           String?
  pokemonTcgIoId     String?  @unique
  tcgplayerProductId String?  @unique
  pricechartingId    String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  set            CardSet         @relation(fields: [setId], references: [id])
  priceSnapshots PriceSnapshot[]
  collectionItems CollectionItem[]
  transactions    Transaction[]
  watchlistItems  WatchlistItem[]
  latestPrice     CardLatestPrice?
  purchaseLots    PurchaseLot[]
  trades          Trade[]         @relation("TradeCard")

  @@index([setId, number])
  @@index([name])
}

// One row per card, refreshed daily by `npm run refresh:card-prices` (see
// scripts/daily-price-sync.ps1) right after price ingestion. Mirrors the
// PRICECHARTING > TCGPLAYER > CARDMARKET cascade in getLatestPrices, but
// precomputed so sorting the full catalog by price doesn't have to run that
// cascade's 3 LATERAL index probes per card on every request -- across the
// ~44k-card catalog that took ~5s; this join is a single indexed lookup.
model CardLatestPrice {
  cardId    String       @id
  price     Decimal      @db.Decimal(10, 2)
  source    PriceSource
  updatedAt DateTime     @updatedAt

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([price])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  name         String?
  // Shareable code so another account can send a friend request without
  // needing an email/username lookup. Nullable -- generated lazily the first
  // time a user opens the Friends section (see getOrCreateFriendCode), not
  // backfilled for existing accounts.
  friendCode   String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collectionItems CollectionItem[]
  transactions    Transaction[]
  watchlistItems  WatchlistItem[]
  purchaseLots    PurchaseLot[]
  ebayAccount     EbayAccount?

  friendshipsSent      Friendship[] @relation("FriendshipRequester")
  friendshipsReceived  Friendship[] @relation("FriendshipAddressee")
  tradeOffersSent      TradeOffer[] @relation("TradeOfferProposer")
  tradeOffersReceived  TradeOffer[] @relation("TradeOfferRecipient")
  trades               Trade[]      @relation("TradeUser")
  tradesAsCounterparty Trade[]      @relation("TradeCounterparty")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

// One directed row per request. Decline/cancel delete the row entirely
// (no DECLINED status) so a person can re-request later without fighting
// the @@unique constraint below -- friendship has no messaging/history
// requirement beyond "are we friends right now."
model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

enum TradeOfferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

// Ephemeral, frequently-polled negotiation state for a live in-app trade --
// kept separate from Trade (the immutable history log) because its shape
// (mutated on every poll tick) doesn't belong in a history table. Each side
// can offer multiple items (see TradeOfferItem below); "nothing picked yet"
// is simply zero rows for that side rather than a nullable placeholder.
model TradeOffer {
  id     String           @id @default(cuid())
  status TradeOfferStatus @default(PENDING)

  proposerId        String
  proposerConfirmed Boolean @default(false)

  recipientId        String
  recipientConfirmed Boolean @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  proposer  User             @relation("TradeOfferProposer", fields: [proposerId], references: [id], onDelete: Cascade)
  recipient User             @relation("TradeOfferRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  items     TradeOfferItem[]

  @@index([recipientId, status])
  @@index([proposerId, status])
}

enum TradeOfferSide {
  PROPOSER
  RECIPIENT
}

// One row per item one side has put on the table. onDelete: Cascade on
// collectionItemId (unlike the old SetNull placeholder design) is fine here
// -- confirmTradeOffer re-validates every row's ownership/quantity before
// executing the swap and cancels if something no longer lines up, so a
// vanished item just means fewer rows to re-validate, not a dangling null.
model TradeOfferItem {
  id               String         @id @default(cuid())
  tradeOfferId     String
  side             TradeOfferSide
  collectionItemId String
  quantity         Int            @default(1)
  createdAt        DateTime       @default(now())

  tradeOffer     TradeOffer     @relation(fields: [tradeOfferId], references: [id], onDelete: Cascade)
  collectionItem CollectionItem @relation(fields: [collectionItemId], references: [id], onDelete: Cascade)

  @@unique([tradeOfferId, side, collectionItemId])
  @@index([tradeOfferId, side])
}

enum TradeSource {
  MANUAL
  LIVE
}

enum TradeDirection {
  GIVEN
  RECEIVED
}

// Unified trade history for both sources: one row per item *movement*
// (either given or received), tagged with a groupId shared by every row
// that belongs to one logical trade event *for this user* -- a manual trade
// with 2 given + 3 received items writes 5 rows under one groupId; a live
// trade writes a separate groupId per participant (their own given+received
// bundle). getTradeHistory groups rows back into one visual event per
// groupId. No price/profit columns anywhere on this model -- a trade is
// never shown as a sale (see the plain-language rule in app/actions/trades.ts).
model Trade {
  id        String         @id @default(cuid())
  userId    String
  source    TradeSource
  direction TradeDirection
  groupId   String

  cardId          String?
  sealedProductId String?
  condition       String?
  quantity        Int
  itemName        String

  // MANUAL only -- freeform, e.g. "Traded with my friend Sam at school."
  counterpartyNote String?
  // LIVE only -- the friend's account.
  counterpartyUserId String?
  // LIVE only -- links both participants' rows back to the same TradeOffer.
  tradeOfferId String?

  tradedAt DateTime @default(now())

  user             User           @relation("TradeUser", fields: [userId], references: [id], onDelete: Cascade)
  counterpartyUser User?          @relation("TradeCounterparty", fields: [counterpartyUserId], references: [id], onDelete: SetNull)
  card             Card?          @relation("TradeCard", fields: [cardId], references: [id], onDelete: SetNull)
  sealedProduct    SealedProduct? @relation("TradeSealed", fields: [sealedProductId], references: [id], onDelete: SetNull)

  @@index([userId, groupId])
  @@index([userId, tradedAt])
  @@index([tradeOfferId])
}

// One user's connected eBay seller account (OAuth "authorization code" grant,
// separate from lib/ebay.ts's app-level client-credentials token used for
// price lookups). Holds the refresh token long-term and the current access
// token, refreshed on demand by lib/ebay-orders.ts.
model EbayAccount {
  userId                String    @id
  ebayUserId            String?
  accessToken           String
  accessTokenExpiresAt  DateTime
  refreshToken          String
  refreshTokenExpiresAt DateTime
  // Cursor for incremental sync: fetchSoldOrders(userId, lastSyncedAt) only
  // requests orders created after this timestamp once it's set. Null means
  // "never synced" -- triggers the full-history backfill in fetchSoldOrders.
  lastSyncedAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CollectionItem {
  id              String   @id @default(cuid())
  userId          String
  cardId          String?
  sealedProductId String?
  condition       String?
  quantity        Int      @default(1)
  costPerUnit     Decimal? @db.Decimal(10, 2)
  createdAt       DateTime @default(now())
  // Marketplace of the most recent PurchaseLot feeding this position (see
  // recomputePosition) -- a position can be built from lots bought in
  // different places, so this is "most recently bought from," not a
  // guaranteed single source.
  marketplace     String?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  card          Card?          @relation(fields: [cardId], references: [id])
  sealedProduct SealedProduct? @relation(fields: [sealedProductId], references: [id])

  tradeOfferItems TradeOfferItem[]

  @@unique([userId, cardId, condition])
  @@unique([userId, sealedProductId, condition])
  @@index([userId])
}

model WatchlistItem {
  id              String   @id @default(cuid())
  userId          String
  cardId          String?
  sealedProductId String?
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  card          Card?          @relation(fields: [cardId], references: [id])
  sealedProduct SealedProduct? @relation(fields: [sealedProductId], references: [id])

  @@unique([userId, cardId])
  @@unique([userId, sealedProductId])
  @@index([userId])
}

model Transaction {
  id               String   @id @default(cuid())
  userId           String
  cardId           String?
  sealedProductId  String?
  itemName         String
  condition        String?
  quantity         Int
  costPerUnit      Decimal? @db.Decimal(10, 2)
  salePricePerUnit Decimal  @db.Decimal(10, 2)
  feesTotal        Decimal? @db.Decimal(10, 2)
  shippingCost     Decimal? @db.Decimal(10, 2)
  profit           Decimal? @db.Decimal(10, 2)
  soldAt           DateTime @default(now())
  // Known marketplace code (see lib/marketplace.ts's MARKETPLACES) or, for
  // "Other", a freeform string typed by the user.
  marketplace      String?
  // Dedup key for automated imports (e.g. "{ebayOrderId}:{ebayLineItemId}"
  // from app/actions/ebay-import.ts). Null for manually-entered sales.
  externalId       String?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  card          Card?          @relation(fields: [cardId], references: [id], onDelete: SetNull)
  sealedProduct SealedProduct? @relation(fields: [sealedProductId], references: [id], onDelete: SetNull)

  @@unique([userId, externalId])
  @@index([userId, soldAt])
}

// One row per buy event (never merged) -- the audit trail behind
// CollectionItem's running quantity/weighted-avg costPerUnit, which stays the
// aggregate source of truth for display/sort/sell. Written in the same
// $transaction as the CollectionItem update on every add-to-collection call,
// so CollectionItem.quantity always equals
// sum(PurchaseLot.quantity) - sum(Transaction.quantity) for the same
// (userId, cardId|sealedProductId, condition) key. Lets the portfolio table's
// drill-down show every buy that built up a position, not just the current
// average.
model PurchaseLot {
  id              String   @id @default(cuid())
  userId          String
  cardId          String?
  sealedProductId String?
  condition       String?
  quantity        Int
  costPerUnit     Decimal? @db.Decimal(10, 2)
  purchasedAt     DateTime @default(now())
  // Known marketplace code (see lib/marketplace.ts's MARKETPLACES) or, for
  // "Other", a freeform string typed by the user.
  marketplace     String?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  card          Card?          @relation(fields: [cardId], references: [id], onDelete: SetNull)
  sealedProduct SealedProduct? @relation(fields: [sealedProductId], references: [id], onDelete: SetNull)

  @@index([userId, cardId, condition])
  @@index([userId, sealedProductId, condition])
}

enum SealedProductType {
  BOOSTER_BOX
  BOOSTER_PACK
  ELITE_TRAINER_BOX
  BUNDLE
  BLISTER
  COLLECTION_BOX
  TIN
  OTHER
  PREMIUM_COLLECTION
  DISPLAY_CASE
  DECK
  POSTER_COLLECTION
  PIN_COLLECTION
  GIFT_BOX
  BINDER
  STARTER_SET
}

model SealedProduct {
  id                 String            @id @default(cuid())
  setId              String?
  name               String
  type               SealedProductType
  imageUrl           String?
  tcgplayerProductId String?           @unique
  tcgplayerGroupId   String?
  pricechartingId    String?           @unique
  // "EN" | "JA". Sealed value diverges sharply between the English and
  // Japanese print of the same set, so the two are tracked as separate
  // products rather than merged.
  language           String            @default("EN")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  set             CardSet?         @relation(fields: [setId], references: [id])
  priceSnapshots  PriceSnapshot[]
  collectionItems CollectionItem[]
  transactions    Transaction[]
  watchlistItems  WatchlistItem[]
  purchaseLots    PurchaseLot[]
  trades          Trade[]          @relation("TradeSealed")

  @@unique([setId, name])
  @@index([name])
  @@index([type])
  @@index([language])
}

enum PriceSource {
  TCGPLAYER
  CARDMARKET
  PRICECHARTING
  EBAY
}

enum PriceType {
  MARKET
  LOW
  MID
  HIGH
  DIRECT_LOW
}

enum PrintVariant {
  NORMAL
  REVERSE_HOLO
}

model PriceSnapshot {
  id              String       @id @default(cuid())
  cardId          String?
  sealedProductId String?
  source          PriceSource
  priceType       PriceType
  condition       String?
  variant         PrintVariant @default(NORMAL)
  price           Decimal      @db.Decimal(10, 2)
  capturedAt      DateTime     @default(now())
  capturedDate    DateTime     @default(now()) @db.Date

  card          Card?          @relation(fields: [cardId], references: [id])
  sealedProduct SealedProduct? @relation(fields: [sealedProductId], references: [id])

  @@unique([cardId, sealedProductId, source, priceType, condition, variant, capturedDate])
  @@index([cardId, capturedAt])
  @@index([sealedProductId, capturedAt])
  @@index([cardId, priceType, variant, source, capturedDate])
}
